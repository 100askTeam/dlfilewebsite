HOST=127.0.0.1
PORT=5001
DL_PUBLIC_DIR=/home1/dlfile
DL_STATE_DIR=/home1/dlfile-state
DL_COOKIE_SECURE=true
DL_ADMIN_USERNAME=admin
# 仅首次启动设置，账号写入 SQLite 后立即从环境文件移除此项。
DL_ADMIN_PASSWORD=replace-with-a-unique-password-of-at-least-12-characters
DL_RELEASE_PUBLIC_KEY_FILE=/etc/dladmin/release.pub
DL_PUBLIC_BASE_URL=https://dl.100ask.net
# dlctl 通过 SSH 执行时使用的后台发布操作者。
DL_RELEASE_ACTOR=admin
